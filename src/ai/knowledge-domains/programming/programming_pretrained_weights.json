{
  "domain": "programming",
  "version": "1.0.0",
  "architecture": "transformer",
  "embedding_dim": 128,
  "hidden_dim": 256,
  "num_layers": 2,
  "weights": {
    "embedding_layer": { "shape": [72, 128], "values": "pretrained_embeddings_placeholder" },
    "attention_weights": {
      "layer_0": {
        "query": { "shape": [128, 128], "init": "xavier" },
        "key": { "shape": [128, 128], "init": "xavier" },
        "value": { "shape": [128, 128], "init": "xavier" }
      }
    },
    "feedforward_weights": {
      "layer_0": {
        "w1": { "shape": [128, 256], "init": "he" },
        "b1": { "shape": [256], "init": "zeros" },
        "w2": { "shape": [256, 128], "init": "he" },
        "b2": { "shape": [128], "init": "zeros" }
      }
    },
    "output_layer": {
      "w": { "shape": [128, 72], "init": "xavier" },
      "b": { "shape": [72], "init": "zeros" }
    }
  },
  "training_config": {
    "learning_rate": 0.001,
    "batch_size": 32,
    "epochs": 100,
    "optimizer": "adam"
  }
}

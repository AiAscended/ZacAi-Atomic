    import { processInput } from '../input-processing/input-processing';
    import { runInference } from '../inference-engine/inference-engine';
    import { getTools } from '../tools/tools';
    import { updateState } from '../state/state';

    export async function heartCycle(input: string, isOffline = false) {
          selfHeal.monitor();  // Continuous background loop
            
              const goal = await processInput(input);

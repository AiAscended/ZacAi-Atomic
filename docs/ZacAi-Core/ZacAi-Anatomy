                                        // packages/core-kernel/src/registries/module-registry.ts
                                        export class ModuleRegistry {
                                          async scan() {
                                              for (const module of systemRegistry.components) {
                                                    const status = await this.checkIntegrity(module.path, module.hash);
                                                          this.available[module.name] = { status, path: module.path };
                                                              }
                                                                  kernel.log('Registry scan complete', this.available);
                                                                    }
                                                                    }
                                                                    ```

                                                                    **Kernel calls this** on boot to get real-time "what's alive?" inventory.


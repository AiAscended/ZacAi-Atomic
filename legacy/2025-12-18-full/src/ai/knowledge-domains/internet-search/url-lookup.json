{
  "domainId": "internet-search",
  "domainName": "Internet Search",
  "sources": [
    {
      "name": "DuckDuckGo",
      "url": "https://api.duckduckgo.com/?q={query}&format=json",
      "description": "Privacy-focused search engine",
      "enabled": true,
      "priority": 1,
      "rateLimit": {
        "requestsPerMinute": 60,
        "requestsPerDay": 5000
      },
      "timeout": 10000
    },
    {
      "name": "Brave Search",
      "url": "https://api.search.brave.com/res/v1/web/search?q={query}",
      "description": "Independent search engine",
      "enabled": false,
      "priority": 2,
      "rateLimit": {
        "requestsPerMinute": 30,
        "requestsPerDay": 2000
      },
      "headers": {
        "Accept": "application/json"
      },
      "timeout": 10000
    },
    {
      "name": "Bing",
      "url": "https://api.bing.microsoft.com/v7.0/search?q={query}",
      "description": "Microsoft search engine",
      "enabled": false,
      "priority": 3,
      "rateLimit": {
        "requestsPerMinute": 3,
        "requestsPerDay": 1000
      },
      "headers": {
        "Ocp-Apim-Subscription-Key": "YOUR_BING_API_KEY"
      },
      "timeout": 10000
    }
  ],
  "defaultSource": "DuckDuckGo",
  "fallbackOrder": ["DuckDuckGo", "Brave Search", "Bing"],
  "cacheEnabled": true,
  "cacheTTL": 1800
}

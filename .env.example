# .env.example

# GitHub App Configuration
# Required to authenticate your app with GitHub and access repositories
GITHUB_APP_ID=your-github-app-id-here
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
your-private-key-content-with-line-breaks-or-\\n
-----END RSA PRIVATE KEY-----"

# Optional: if you ever add webhook handling, store your webhook secret here
# GITHUB_APP_WEBHOOK_SECRET=your-webhook-secret-here
